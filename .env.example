# --- PostgreSQL с рыночными данными (сервис market-postgres в docker-compose) ---
# Значения по умолчанию совпадают с docker-compose, поэтому для локального стека их можно не менять.
DATABASE_URL="postgresql://market:market@market-postgres:5432/market"
DB_HOST=market-postgres
DB_PORT=5432
DB_USER=market
DB_PASS=market
DB_NAME=market
# Порт, на который база публикуется на хост (для IDE/psql; 5432 обычно занят локальным Postgres)
DB_HOST_PORT=5433

# --- Токен API Algopack Московской биржи ---
MOEX_API_TOKEN='токен api algopack московской биржи'

# --- Airflow ---
AIRFLOW_UID=50000
